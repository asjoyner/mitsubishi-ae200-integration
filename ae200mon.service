# NOT the installed copy. The deploy tool owns the unit it installs:
# ae200monUnit in deploy/services_alfred.go, and `sudo deploy ae200mon`
# rewrites /etc/systemd/system/ae200mon.service from there. Editing this
# file changes nothing on the box; keep it in step with that const.
[Unit]
Description=AE-200 Monitoring Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/mitsubishi-ae200-integration/venv/bin/python -m ae200mon --config /opt/mitsubishi-ae200-integration/ae200mon.yaml
WorkingDirectory=/opt/mitsubishi-ae200-integration
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
